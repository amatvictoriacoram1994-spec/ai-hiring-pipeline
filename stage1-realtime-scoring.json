    {
      "parameters": {
        "jsCode": "const rawText = $input.item.json.content[0].text;\n\nconst cleaned = rawText\n  .replace(/```json\\s*/g, '')\n  .replace(/```\\s*/g, '')\n  .trim();\n\nconst requiredFields = {\n  overall_score: 'number',\n  technical_score: 'number',\n  experience_score: 'number',\n  ownership_score: 'number',\n  skills_found: 'object',\n  skills_missing: 'object',\n  ownership_signal: 'string',\n  contradiction_flag: 'boolean',\n  ai_recommendation: 'string',\n  ai_reason: 'string',\n  flags: 'object'\n};\n\nlet parsed;\nlet validationErrors = [];\n\ntry {\n  parsed = JSON.parse(cleaned);\n} catch (err) {\n  return [{\n    json: {\n      validation_passed: false,\n      validation_error: 'JSON_PARSE_FAILED: ' + err.message,\n      raw_claude_output: rawText\n    }\n  }];\n}\n\nfor (const [field, expectedType] of Object.entries(requiredFields)) {\n  if (!(field in parsed)) {\n    validationErrors.push(`Missing field: ${field}`);\n  } else if (typeof parsed[field] !== expectedType) {\n    validationErrors.push(`Field ${field} expected ${expectedType}, got ${typeof parsed[field]}`);\n  }\n}\n\n['overall_score', 'technical_score', 'experience_score', 'ownership_score'].forEach(f => {\n  if (parsed[f] !== undefined && (parsed[f] < 0 || parsed[f] > 10)) {\n    validationErrors.push(`Field ${f} out of expected range 0-10: ${parsed[f]}`);\n  }\n});\n\nif (validationErrors.length > 0) {\n  return [{\n    json: {\n      validation_passed: false,\n      validation_error: validationErrors.join('; '),\n      raw_claude_output: rawText\n    }\n  }];\n}\n\nreturn [{\n  json: {\n    validation_passed: true,\n    ...parsed\n  }\n}];"
      },
